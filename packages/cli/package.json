{
  "name": "@inpageedit/cli",
  "version": "0.2.0",
  "description": "InPageEdit CLI for MediaWiki profiles and page editing",
  "license": "MIT",
  "homepage": "https://github.com/inpageedit/inpageedit-next/tree/master/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inpageedit/inpageedit-next.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/inpageedit/inpageedit-next/issues"
  },
